# ===== 投递产物：不入库 =====
# 仅忽略根目录 PDF —— 可从 md 重建，且体积大，避免二进制污染版本库
# 注意：docs/ 下的证明材料（合同盖章件、录用/离职证明、立项文件）是核心资产，
#       丢了不可再生，必须入库。因此这里用 / 限定作用域，绝不能写成 *.pdf
/*.pdf

# PDF 输出目录：忽略内容，保留 .gitkeep 占位（确保目录能被 git 跟踪）
_output/*
!.gitkeep

# ===== 工作区中间产物 =====
# _temp 整体忽略，但构建脚本 _temp/scripts/ 例外入库（防人工清空后丢失，git 可恢复）
# 注意必须写 _temp/* 而非 _temp/ —— 后者会忽略整个目录，导致否定规则失效
_temp/*
!_temp/scripts/
_backup/
.edge-profile/

# ===== 工具与编辑器 =====
.workbuddy/
.vscode/
